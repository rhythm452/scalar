{
  "name": "scalar-r53",
  "account_id": "{FILL_ME}",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "API_ORIGIN": "https://scalar-api.fly.dev"
  },
  "observability": {
    "enabled": true
  }
}
